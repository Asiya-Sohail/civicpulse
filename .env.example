# FreeNewsAPI is keyless. Hourly collection re-fetches a 4-hour overlap; increase for recovery
# after longer outages. Duplicate URLs are removed during the warehouse build.
FREENEWSAPI_LOOKBACK_HOURS=4

# Feed older than this many hours is flagged STALE
STALE_AFTER_HOURS=3

# One-time GDELT history backfill: how many days back and sampled 15-minute files/day (1-96)
GDELT_DAYS_BACK=740
GDELT_PER_DAY=4

# OpenRouter generative answer layer (copy these settings to your private .env file).
# Get the API key from your OpenRouter account; never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=CivicPulse
# Chroma cosine-distance cutoff; lower values require closer matches.
RAG_MAX_DISTANCE=0.95

# Supabase Gold-layer sync (server-side only; never expose this secret key in a frontend).
# Find the Project URL and a Secret key in Supabase Dashboard > Settings > API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SYNC_BATCH_SIZE=500

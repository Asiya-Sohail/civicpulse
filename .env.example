# Copy to .env (never commit .env). Free key: https://newsagentdata.com
NEWSAGENT_API_KEY=
# Verified from the provider's OpenAPI spec; leave these as they are unless the API changes.
# BASE_URL must be the host only: no /v1, no path.
NEWSAGENT_BASE_URL=https://api.newsagentdata.com
NEWSAGENT_ENDPOINT=/v1/feed
NEWSAGENT_AUTH_HEADER=X-API-Key
NEWSAGENT_AUTH_SCHEME=
NEWSAGENT_COUNTRY=pk
NEWSAGENT_PAGE_SIZE=100

# Feed older than this many hours is flagged STALE
STALE_AFTER_HOURS=3

# One-time GDELT history backfill: how many days back and sampled 15-minute files/day (1-96)
GDELT_DAYS_BACK=740
GDELT_PER_DAY=2

# Copy to .env (never commit .env). Get a free key at https://newsagentdata.com
NEWSAGENT_API_KEY=nap_-xmyGIQU_Cm48iylBWkEn_PCmcduSila8G81SROJ8z8
# Copy these three from the provider's API docs / dashboard after you sign up.
# They are NOT verified in this repo, so check them with:  python -m civicpulse probe-newsagent
NEWSAGENT_BASE_URL=https://api.newsagentdata.com/v1
NEWSAGENT_ENDPOINT=/v1/feed
NEWSAGENT_AUTH_HEADER=X-API-Key
# Set to "Bearer" if the docs say Authorization: Bearer <key>, then set AUTH_HEADER=Authorization
NEWSAGENT_AUTH_SCHEME=
NEWSAGENT_COUNTRY=pk
NEWSAGENT_LIMIT=100

# Feed older than this many hours is flagged STALE
STALE_AFTER_HOURS=3

# GDELT history: how many days back, and how many 15-minute files to take per day (1-96)
GDELT_DAYS_BACK=740
GDELT_PER_DAY=2
